rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isAuctionManagerOf(auction) {
      return isSignedIn() &&
        (role() == 'admin' || (role() == 'auctionManager' && request.auth.uid in auction.auctionManagerIds));
    }

    function isRegisteredManagerOf(auction) {
      return isSignedIn() && role() == 'manager' && request.auth.uid in auction.teamManagerIds;
    }

    function adminNotYetClaimed() {
      return !exists(/databases/$(database)/documents/meta/adminClaimed) ||
        get(/databases/$(database)/documents/meta/adminClaimed).data.claimed == false;
    }

    function canManageAuctions() {
      return isSignedIn() && (role() == 'admin' || role() == 'auctionManager' || role() == 'manager');
    }

    // Admins, Auction Managers, and Team Managers can all promote a viewer to
    // Player (e.g. spotting them in the crowd, or approving a self-service
    // request) without a broader role change. playerRequested is cleared in
    // the same write so an approved request doesn't linger.
    function isPromotingViewerToPlayer() {
      return resource.data.role == 'viewer' &&
        request.resource.data.role == 'player' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'playerRequested']);
    }

    // Covers both: an Auction Manager self-assigning to an auction they just
    // created, and any manager role registering someone else (e.g. a Player)
    // to an auction — without granting broader access to the user doc.
    function isUpdatingAssignedAuctions() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedAuctions']);
    }

    // A viewer flagging their own request to become a Player.
    function isRequestingToBePlayer() {
      return resource.data.role == 'viewer' &&
        request.resource.data.role == 'viewer' &&
        request.resource.data.playerRequested == true &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerRequested']);
    }

    function isAdminOrAuctionManager() {
      return isSignedIn() && (role() == 'admin' || role() == 'auctionManager');
    }

    function hasNoPendingPhotoRequest() {
      return !('pendingPhotoRequest' in resource.data) ||
        resource.data.pendingPhotoRequest == null ||
        resource.data.pendingPhotoRequest.status != 'pending';
    }

    // An Admin/Auction Manager proposing a replacement photo for someone
    // else. Restricted to touching pendingPhotoRequest only — never the live
    // filenPhotoId — so the target's approval can never be bypassed. Blocks
    // starting a new request while one is already pending (avoids a race
    // between two managers), and requestedBy must be the caller (can't be
    // spoofed as coming from someone else).
    function isRequestingPhotoChange(userId) {
      return isAdminOrAuctionManager() && userId != request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingPhotoRequest']) &&
        hasNoPendingPhotoRequest() &&
        request.resource.data.pendingPhotoRequest.status == 'pending' &&
        request.resource.data.pendingPhotoRequest.requestedBy == request.auth.uid;
    }

    // The requester dismissing a resolved (non-pending) outcome on someone
    // else's doc — the only write an Auction Manager (who lacks isAdmin())
    // can make here besides isRequestingPhotoChange. The target's own
    // approve/reject write goes through the generic self-update clause below
    // (it's their own doc — no extra rule needed for that direction).
    function isClearingResolvedPhotoRequest(userId) {
      return isAdminOrAuctionManager() && userId != request.auth.uid &&
        'pendingPhotoRequest' in resource.data && resource.data.pendingPhotoRequest != null &&
        resource.data.pendingPhotoRequest.requestedBy == request.auth.uid &&
        resource.data.pendingPhotoRequest.status != 'pending' &&
        request.resource.data.pendingPhotoRequest == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingPhotoRequest']);
    }

    // A lightweight, host-run "pick two captains, draft the rest" pre-match
    // roster session — separate from /matches (live scoring, gated to
    // admin/auctionManager) since any signed-in user should be able to run a
    // pickup game. Turn order and pick legality are enforced client-side
    // (DraftMatchRepository), the same trust boundary /auctions/{id}/bids
    // already relies on for bid amounts — the rules below only gate who's a
    // participant, not whether a given write is the "right" one.
    function isDraftHost(draftMatch) {
      return isSignedIn() && request.auth.uid == draftMatch.hostUid;
    }

    // Joining is itself a write (appending your own uid before the rule
    // that trusts "already joined" would apply to you) — scoped so it can
    // only add the caller's own uid, never anyone else's or a broader edit.
    function isJoiningDraftMatch(draftMatch) {
      return isSignedIn() &&
        !(request.auth.uid in draftMatch.joinedUids) &&
        request.auth.uid in request.resource.data.joinedUids &&
        request.resource.data.diff(draftMatch).affectedKeys().hasOnly(['joinedUids', 'players']);
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      // Broadened from admin/auctionManager/manager-only so any signed-in
      // host can search the platform's player directory when building a
      // Team Draft match roster (see draftMatches below) — every doc here
      // was already readable one-by-one via `get` to any signed-in user, so
      // this only changes enumeration, not per-doc visibility.
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.assignedAuctions.size() == 0 &&
        (request.resource.data.role == 'viewer' ||
          (exists(/databases/$(database)/documents/invites/$(request.auth.token.email)) &&
            request.resource.data.role ==
              get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role));
      allow update: if isAdmin() ||
        (canManageAuctions() && isPromotingViewerToPlayer()) ||
        (canManageAuctions() && isUpdatingAssignedAuctions()) ||
        isRequestingPhotoChange(userId) ||
        isClearingResolvedPhotoRequest(userId) ||
        (isSignedIn() && request.auth.uid == userId && isRequestingToBePlayer()) ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.assignedAuctions == resource.data.assignedAuctions) ||
        (isSignedIn() && request.auth.uid == userId &&
          resource.data.role != 'admin' &&
          request.resource.data.role == 'admin' &&
          request.resource.data.assignedAuctions == resource.data.assignedAuctions &&
          adminNotYetClaimed());
    }

    match /teams/{teamId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow create: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow update: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow delete: if isAdmin();
    }

    match /venues/{venueId} {
      allow get: if isSignedIn();
      allow list: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow create: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow update: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow delete: if isAdmin();
    }

    match /invites/{inviteId} {
      allow get: if isSignedIn() && request.auth.token.email == inviteId;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.token.email == inviteId);
    }

    // One doc per issued short user ID (see ensureUserDoc in lib/auth.ts),
    // used only to guarantee codes are unique at creation time — never
    // queried by the app directly (the search-by-ID feature reads userCode
    // off the users collection, which is already listable).
    match /userCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    match /meta/adminClaimed {
      allow get: if isSignedIn();
      allow write: if isSignedIn() &&
        adminNotYetClaimed() &&
        request.resource.data.claimed == true;
    }

    match /auctions/{auctionId} {
      allow get: if true;
      // Public, matching `get` — lets a Viewer (who may not even have an
      // account) browse ongoing auctions from the Join page without needing
      // to already know an auction ID.
      allow list: if true;
      allow create: if isSignedIn() && (role() == 'admin' || role() == 'auctionManager');
      allow update: if isAuctionManagerOf(resource.data) || isRegisteredManagerOf(resource.data);
      allow delete: if isAuctionManagerOf(resource.data);

      match /bids/{playerId} {
        allow get: if true;
        allow list: if isSignedIn();
        allow write: if isAuctionManagerOf(get(/databases/$(database)/documents/auctions/$(auctionId)).data) ||
          isRegisteredManagerOf(get(/databases/$(database)/documents/auctions/$(auctionId)).data);
      }

      match /teams/{teamId} {
        allow get: if true;
        allow list: if true;
        allow write: if isAuctionManagerOf(get(/databases/$(database)/documents/auctions/$(auctionId)).data);
      }
    }

    match /matches/{matchId} {
      // Public, same reasoning as auctions — a live scoreboard needs to be
      // watchable without an account.
      allow get: if true;
      allow list: if true;
      // Broadened from admin/auctionManager-only so a Team Draft host (see
      // isDraftHost below — any signed-in user, not just admin/
      // auctionManager) can go straight from "Let's Play" into live
      // scoring for their own casual match, the same trust boundary
      // draftMatches already uses.
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.createdBy &&
        request.auth.uid in request.resource.data.scorerIds;
      // Any signed-in user the creator has added to scorerIds can operate the
      // live counter — deliberately not restricted to admin/auctionManager,
      // per the "anyone can be a scorer" requirement (see requirements.md).
      allow update: if isAdmin() ||
        (isSignedIn() && role() == 'auctionManager') ||
        (isSignedIn() && request.auth.uid in resource.data.scorerIds);
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.createdBy);

      match /balls/{ballId} {
        allow get: if true;
        allow list: if true;
        allow write: if isAdmin() ||
          (isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.scorerIds);
      }
    }

    match /draftMatches/{matchId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.hostUid;
      allow update: if isDraftHost(resource.data) ||
        (isSignedIn() && request.auth.uid in resource.data.joinedUids) ||
        isJoiningDraftMatch(resource.data);
      allow delete: if isDraftHost(resource.data);
    }

    match /tournaments/{tournamentId} {
      allow get: if true;
      allow list: if true;
      allow create: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow update: if isAdmin() || (isSignedIn() && role() == 'auctionManager');
      allow delete: if isAdmin();
    }

    // Career numbers, aggregated automatically off completed matches (see
    // lib/playerStats.ts) — nobody writes these by hand.
    match /playerStats/{playerId} {
      allow get: if true;
      allow list: if true;
      // Also writable by a scorer of the completed match the write names in
      // lastMatchId — the one who records a match's final ball applies it
      // to career stats, and a Team Draft host isn't necessarily an admin.
      allow write: if isAdmin() || (isSignedIn() && role() == 'auctionManager') ||
        (isSignedIn() && request.resource.data.lastMatchId is string &&
          get(/databases/$(database)/documents/matches/$(request.resource.data.lastMatchId)).data.status == 'completed' &&
          request.auth.uid in get(/databases/$(database)/documents/matches/$(request.resource.data.lastMatchId)).data.scorerIds);
    }
  }
}
