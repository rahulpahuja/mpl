VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App-wide symmetric key used to AES-GCM encrypt profile photos before they're
# stored on the user doc (see src/lib/crypto.ts). Generate one with:
#   openssl rand -base64 32
# Changing this key makes previously-saved photos undecryptable.
VITE_PROFILE_IMAGE_KEY=

# Base URL of the Filen proxy backend (see server/README.md) — e.g.
# https://mpl-filen-proxy.onrender.com. No trailing slash.
VITE_FILEN_PROXY_URL=
