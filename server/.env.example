PORT=8787

# Comma-separated list of origins allowed to call this proxy.
ALLOWED_ORIGINS=https://thempl.netlify.app,http://localhost:5173

# Filen account credentials — create a dedicated account for this app,
# don't reuse a personal one.
FILEN_EMAIL=
FILEN_PASSWORD=
# Only set this if 2FA is enabled on the Filen account. A hardcoded code only
# works for the login() call at process boot (fine on an always-on server) —
# it will NOT survive a restart, since a fresh code is needed every time
# login() re-runs. On the free Render tier specifically (spins down on idle,
# cold-starts on the next request — see server/README.md) that means every
# cold start would fail 2FA with a stale code. Simplest fix: disable 2FA on
# this dedicated account and leave this blank.
FILEN_TWO_FACTOR_CODE=

# Optional — defaults to /mpl-uploads if unset.
FILEN_BASE_FOLDER=/mpl-uploads

# Full Firebase service-account JSON (Project Settings -> Service Accounts ->
# Generate new private key), base64-encoded onto one line:
#   base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
